.DS_Store

# Local version overrides for docker compose (see the BOM note in
# docker-compose.yml). Never committed — the certified versions live in the
# compose file itself.
.env
node_modules/

# The assembled Pages artifact: site/index.html at the root with website/dist
# beneath it as docs/. Built by .github/workflows/docs-site.yml, and locally by
# the same two commands; never a source tree.
_site/

# scripts/build_landing_data.py imports family_parity.py by path, which leaves
# bytecode beside it.
__pycache__/

# Local tooling
.nwave/
